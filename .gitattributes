# Normalize all text files to LF in repo
* text=auto eol=lf

# Common source files
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary files (no conversion)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.exe  binary
*.dll  binary
